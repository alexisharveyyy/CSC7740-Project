# Copy to .env on the Spark master and source it before running any stage.
# Every value below is the default the code assumes; change it only if the cluster differs.

# HDFS root that holds raw/, conformed/, cleaned/, features/, models/, predictions/, stream/
BACKBLAZE_HDFS_ROOT=hdfs://master:9000/backblaze

# Spark standalone master (spark-defaults.conf also sets this, so spark-submit works without --master)
SPARK_MASTER_URL=spark://master:7077

# ClickHouse serving layer. The backblaze database must exist; the scripts create the tables.
# compress=0 is required: ClickHouse 26 changed its default HTTP compression and the JDBC driver
# otherwise fails to read query results (Invalid LZ4 magic byte)
CLICKHOUSE_JDBC_URL=jdbc:clickhouse://master:8123/backblaze?compress=0
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Shaded ClickHouse JDBC driver for spark-submit --jars (spark-submit --packages cannot fetch the :all classifier)
# curl -L -o ~/jars/clickhouse-jdbc-0.6.3-all.jar https://github.com/ClickHouse/clickhouse-java/releases/download/v0.6.3/clickhouse-jdbc-0.6.3-all.jar
CLICKHOUSE_JDBC_JAR=$HOME/jars/clickhouse-jdbc-0.6.3-all.jar
