# Copy to .env on the Spark master and source it before running any stage.
# Every value below is the default the code assumes; change it only if the cluster differs.

# HDFS root that holds raw/, conformed/, cleaned/, features/, models/, predictions/, stream/
BACKBLAZE_HDFS_ROOT=hdfs://master:9000/backblaze

# Spark standalone master (spark-defaults.conf also sets this, so spark-submit works without --master)
SPARK_MASTER_URL=spark://master:7077

# ClickHouse serving layer. The backblaze database must exist; the scripts create the tables.
CLICKHOUSE_JDBC_URL=jdbc:clickhouse://master:8123/backblaze
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
