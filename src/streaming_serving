#Streaming
from __future__ import annotations

import os

from pyspark.sql import DataFrame
from pyspark.sql import functions as F

from common import FEATURE_DIR, build_spark_session
from serving_layer import (
    CLICKHOUSE_DRIVER,
    CLICKHOUSE_PASSWORD,
    CLICKHOUSE_URL,
    CLICKHOUSE_USER,
    build_drive_risk_watchlist,
)

STREAM_INPUT_DIR = os.environ.get(
    "BACKBLAZE_STREAM_INPUT_DIR",
    f"{FEATURE_DIR}/incoming",
)

CHECKPOINT_DIR = os.environ.get(
    "BACKBLAZE_STREAM_CHECKPOINT_DIR",
    f"{FEATURE_DIR}/checkpoints",
)

TRIGGER_INTERVAL = os.environ.get(
    "BACKBLAZE_STREAM_TRIGGER_INTERVAL",
    "30 seconds",
)

STREAM_TABLE = "drive_risk_watchlist"


def write_watchlist_batch(batch: DataFrame, batch_id: int) -> None:
    if batch.isEmpty():
        return

    # The batch contains only newly arrived feature rows. Reusing the existing
    # Watch list logic keeps streaming and batch scoring consistent.
    watchlist = (
        build_drive_risk_watchlist(batch)
        .withColumn("stream_batch_id", F.lit(batch_id))
    )

    (
        watchlist.write.format("jdbc")
        .option("url", CLICKHOUSE_URL)
        .option("driver", CLICKHOUSE_DRIVER)
        .option("user", CLICKHOUSE_USER)
        .option("password", CLICKHOUSE_PASSWORD)
        .option("dbtable", STREAM_TABLE)
        .option("batchsize", 10000)
        .option("isolationLevel", "NONE")
        .mode("append")
        .save()
    )


def stream_drive_risk_scoring() -> None:
    spark = build_spark_session("backblaze-streaming-serving")

    # File streams require a fixed schema. The existing feature dataset provides
    # The contract expected by the risk scoring logic.
    feature_schema = spark.read.parquet(FEATURE_DIR).schema

    incoming_features = (
        spark.readStream
        .schema(feature_schema)
        .option("maxFilesPerTrigger", 10)
        .parquet(STREAM_INPUT_DIR)
    )

    query = (
        incoming_features.writeStream
        .queryName("drive-risk-watchlist")
        .foreachBatch(write_watchlist_batch)
        .option("checkpointLocation", CHECKPOINT_DIR)
        .trigger(processingTime=TRIGGER_INTERVAL)
        .start()
    )

    query.awaitTermination()


def main() -> None:
    stream_drive_risk_scoring()


if __name__ == "__main__":
    main()
